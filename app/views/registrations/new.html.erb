<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">Create an account</h1>

    <%= form_with(model: @user, url: sign_up_path, class: "auth-form") do |form| %>


      <div class="form-group">
        <%= form.label :username, "Username", class: "form-label required" %>
        <%= form.text_field :username, autofocus: true, autocomplete: "username", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :email_address, "Email", class: "form-label required" %>
        <%= form.email_field :email_address, autocomplete: "email", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :password, "Password", class: "form-label required" %>
        <%= form.password_field :password, autocomplete: "new-password", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :password_confirmation, "Re-enter Password", class: "form-label required" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
      </div>
      <p class="terms-text">
        By Clicking "Create Account", you agree to our <a href="#" class="auth-link">Terms and Conditions</a> and have read the <a href="#" class="auth-link">Privacy Policy</a>.
      </p>

      <div class="form-actions" style="margin-top:0;">
        <%= form.submit "Create Account", class: "btn-primary" %>
      </div>
    <% end %>

    <div class="auth-links">
      <p>Already have an account? <%= link_to "Log in", new_session_path, class: "auth-link" %></p>
    </div>
  </div>
</div>
