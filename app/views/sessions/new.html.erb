<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">Sign In</h1>



    <%= form_with url: session_path, class: "auth-form" do |form| %>
      <div class="form-group">
        <%= form.label :username, "Username", class: "form-label required" %>
        <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", class: "form-input", value: params[:username] %>
      </div>

      <div class="form-group">
        <%= form.label :password, "Password", class: "form-label required" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", class: "form-input", maxlength: 72 %>
      </div>



      <div class="form-actions" style="margin-top:0;">
        <%= form.submit "Sign In", class: "btn-primary" %>
      </div>
    <% end %>

    <div class="auth-links">
      <p>Don't have an account? <%= link_to "Register", sign_up_path, class: "auth-link" %></p>
    </div>
  </div>
</div>
