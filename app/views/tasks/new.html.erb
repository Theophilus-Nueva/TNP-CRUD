<div class="tasks-container">
  <div class="tasks-header">
    <h1 class="tasks-title">Create New Task</h1>
  </div>

  <div class="task-card">
    <%= form_with(model: @task, url: tasks_path) do |form| %>


      <div class="form-group">
        <%= form.label :title, "Task Title", class: "form-label required" %>
        <%= form.text_field :title, required: true, autofocus: true, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :description, "Description", class: "form-label" %>
        <%= form.text_area :description, class: "form-input", rows: 3 %>
      </div>

      <div class="form-group">
        <%= form.label :status, "Status", class: "form-label required" %>
        <%= form.select :status, options_for_select(["In Progress", "For Review", "Completed"], "In Progress"), {}, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :user_id, "Assign To", class: "form-label required" %>
        <%= form.collection_select :user_id, @users, :id, :username, { selected: Current.user.id }, class: "form-input" %>
      </div>

      <div class="form-actions" style="display: flex; gap: 1rem; align-items: center; margin-top: 1rem;">
        <%= form.submit "Create Task", class: "btn-tasks btn-my-tasks", style: "border: none; cursor: pointer; height: 36px;" %>
        <%= link_to "Cancel", tasks_path, style: "color: var(--text-secondary); text-decoration: none; font-size: 0.9rem;" %>
      </div>
    <% end %>
  </div>
</div>
